<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="View.EditListingController"
      spacing="15"
      style="-fx-background-color: #F5F0E8;"
      prefWidth="700" prefHeight="700">
    
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- Header -->
    <Text text="Edit Listing"
          style="-fx-fill: #143D29;
                 -fx-font-family: 'Palatino Linotype';
                 -fx-font-size: 28px;
                 -fx-font-weight: bold;"/>

    <!-- Scrollable Form -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F0E8; -fx-background-color: transparent;">
        <VBox spacing="15">
            <padding>
                <Insets right="10"/>
            </padding>

            <!-- Location Section -->
            <Text text="Location Information"
                  style="-fx-fill: #1A5F3F; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            
            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <Label text="Street Name *" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="streetField" promptText="e.g., Niels Juels Gade"
                          GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                <Label text="Room Number" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="roomNumberField" promptText="e.g., 12A"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="City/Region *" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="regionField" promptText="e.g., Copenhagen"
                          GridPane.rowIndex="3" GridPane.columnIndex="0"/>

                <Label text="Country *" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="countryField" text="Denmark"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Postal Code *" GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="postalCodeField" promptText="e.g., 1054"
                          GridPane.rowIndex="5" GridPane.columnIndex="0"/>

                <Label text="Floor" GridPane.rowIndex="4" GridPane.columnIndex="1"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="floorField" promptText="e.g., 3"
                          GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>

            <Separator style="-fx-background-color: #D4C4B0;"/>

            <!-- Property Details Section -->
            <Text text="Property Details"
                  style="-fx-fill: #1A5F3F; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <Label text="Number of Rooms *" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="roomsField" promptText="e.g., 3"
                          GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                <Label text="Number of Bathrooms *" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="bathroomsField" promptText="e.g., 2"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Surface Area (m²) *" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="surfaceAreaField" promptText="e.g., 95.5"
                          GridPane.rowIndex="3" GridPane.columnIndex="0"/>

                <Label text="Max Number of People *" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="maxPeopleField" promptText="e.g., 4"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Has Balcony?" GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <CheckBox fx:id="balconyCheckBox" text="Yes"
                         GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            </GridPane>

            <Separator style="-fx-background-color: #D4C4B0;"/>

            <!-- Financial & Date Section -->
            <Text text="Rental Information"
                  style="-fx-fill: #1A5F3F; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <Label text="Monthly Rent (DKK) *" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="priceField" promptText="e.g., 2800"
                          GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                <Label text="Last Renovated *" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <DatePicker fx:id="renovatedDatePicker" promptText="Select date"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Check-in Time *" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="checkInTimeField" promptText="15:00"
                          GridPane.rowIndex="3" GridPane.columnIndex="0"/>

                <Label text="Check-out Time *" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="checkOutTimeField" promptText="11:00"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </ScrollPane>

    <!-- Error/Success Messages -->
    <Label fx:id="messageLabel" 
           wrapText="true"
           style="-fx-text-fill: #B22222; -fx-font-weight: bold;"/>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancel" 
                onAction="#handleCancel"
                style="-fx-background-color: #D4C4B0;
                       -fx-text-fill: #143D29;
                       -fx-font-size: 14px;
                       -fx-background-radius: 5;
                       -fx-padding: 10 20;"/>
        
        <Button fx:id="updateButton" 
                text="Update Listing" 
                onAction="#handleUpdate"
                style="-fx-background-color: #143D29;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-background-radius: 5;
                       -fx-padding: 10 20;"/>
    </HBox>
</VBox>
