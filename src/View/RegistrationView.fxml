<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="View.RegistrationController"
           style="-fx-background-color: #F5F0E8;">

    <!-- Scrollable container for the form -->
    <ScrollPane fitToWidth="true" fitToHeight="true"
                style="-fx-background: #F5F0E8; -fx-background-color: #F5F0E8;">
        
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #F5F0E8;">
            <padding>
                <Insets top="40" right="20" bottom="40" left="20"/>
            </padding>

            <!-- Registration Card -->
            <VBox fx:id="formContainer" spacing="24" alignment="CENTER_LEFT" maxWidth="520"
                  style="-fx-background-color: #EDE8DC;
                         -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 14, 0, 0, 4);">
                <padding>
                    <Insets top="50" right="60" bottom="50" left="60"/>
                </padding>

                <!-- Title -->
                <Text text="Create Account"
                      style="-fx-fill: #143D29;
                             -fx-font-family: 'Palatino Linotype';
                             -fx-font-size: 42px;
                             -fx-font-weight: bold;
                             -fx-font-style: italic;"/>

                <!-- Subtitle -->
                <Text text="Register as a new client"
                      style="-fx-fill: #1A5F3F;
                             -fx-font-family: 'Cambria';
                             -fx-font-size: 16px;"/>

                <!-- Two-column layout for name fields -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="First Name *" styleClass="field-label"/>
                        <TextField fx:id="firstNameField" promptText="Enter first name"
                                   maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Last Name *" styleClass="field-label"/>
                        <TextField fx:id="lastNameField" promptText="Enter last name"
                                   maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Email field -->
                <VBox spacing="6">
                    <Label text="Email *" styleClass="field-label"/>
                    <TextField fx:id="emailField" promptText="your.email@example.com"
                               maxWidth="Infinity"/>
                </VBox>

                <!-- Phone field -->
                <VBox spacing="6">
                    <Label text="Phone Number *" styleClass="field-label"/>
                    <TextField fx:id="phoneField" promptText="10 digits only (e.g., 1234567890)"
                               maxWidth="Infinity"/>
                </VBox>

                <!-- Username field -->
                <VBox spacing="6">
                    <Label text="Username *" styleClass="field-label"/>
                    <TextField fx:id="usernameField" promptText="Choose a username (min. 3 characters)"
                               maxWidth="Infinity"/>
                </VBox>

                <!-- Two-column layout for password fields -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Password *" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" promptText="Min. 6 characters"
                                       maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Confirm Password *" styleClass="field-label"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password"
                                       maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Date of Birth -->
                <VBox spacing="6">
                    <Label text="Date of Birth *" styleClass="field-label"/>
                    <DatePicker fx:id="dobPicker" promptText="Select your birth date"
                                maxWidth="Infinity"
                                style="-fx-background-color: #FFFFFF;
                                       -fx-border-color: #C8C1AE;
                                       -fx-border-radius: 6;
                                       -fx-background-radius: 6;"/>
                </VBox>

                <!-- Two-column layout for gender and nationality -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Gender *" styleClass="field-label"/>
                        <ComboBox fx:id="genderComboBox" promptText="Select gender"
                                  maxWidth="Infinity"
                                  style="-fx-background-color: #FFFFFF;
                                         -fx-border-color: #C8C1AE;
                                         -fx-border-radius: 6;
                                         -fx-background-radius: 6;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Nationality *" styleClass="field-label"/>
                        <TextField fx:id="nationalityField" promptText="Your nationality"
                                   maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Error message label -->
                <Label fx:id="errorLabel" wrapText="true" maxWidth="Infinity"
                       style="-fx-text-fill: #B71C1C; 
                              -fx-font-family: 'Cambria'; 
                              -fx-font-size: 13px;
                              -fx-padding: 4 0;"
                       visible="false" managed="false"/>

                <!-- Buttons -->
                <HBox spacing="14" alignment="CENTER_RIGHT">
                    <Button fx:id="backToLoginButton" text="Back to Login" 
                            onAction="#handleBackToLogin"
                            styleClass="btn-secondary"/>
                    <Button fx:id="registerButton" text="Create Account" 
                            onAction="#handleRegister"
                            styleClass="btn-primary"/>
                </HBox>

                <!-- Required fields note -->
                <Text text="* Required fields"
                      style="-fx-fill: #8B7355;
                             -fx-font-family: 'Cambria';
                             -fx-font-size: 12px;
                             -fx-font-style: italic;"/>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- ESC hint (top-right) -->
    <Label text="Press ESC to exit fullscreen"
           style="-fx-text-fill: #8B7355; -fx-padding: 15px;
                  -fx-font-family: 'Cambria'; -fx-font-size: 14px;">
        <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
    </Label>

</StackPane>
