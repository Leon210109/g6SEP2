<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="View.AdminController"
      spacing="20"
      style="-fx-background-color: #F5F0E8;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Text text="Owner Applications"
                  style="-fx-fill: #143D29;
                         -fx-font-family: 'Palatino Linotype';
                         -fx-font-size: 36px;
                         -fx-font-weight: bold;"/>
            <Text text="Review and approve or reject pending applications"
                  style="-fx-fill: #8B7355;
                         -fx-font-family: 'Cambria';
                         -fx-font-size: 14px;"/>
        </VBox>
        <Button text="↻ Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #1A5F3F;
                       -fx-text-fill: white;
                       -fx-font-family: 'Cambria';
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;
                       -fx-padding: 8 18;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- Applications list -->
    <ScrollPane fx:id="applicationsScrollPane"
                fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F0E8; -fx-background-color: transparent;">

        <TilePane fx:id="applicationsTilePane"
                  hgap="20" vgap="20"
                  prefColumns="2"
                  style="-fx-background-color: #F5F0E8;"/>
    </ScrollPane>

    <!-- Status label -->
    <Label fx:id="statusLabel"
           text="Loading applications..."
           style="-fx-text-fill: #8B7355;
                  -fx-font-family: 'Cambria';
                  -fx-font-size: 13px;"/>

</VBox>
