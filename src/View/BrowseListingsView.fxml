<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="View.BrowseListingsController"
      spacing="20"
      style="-fx-background-color: #F5F0E8;">
    
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Header Section -->
    <VBox spacing="10">
        <Text text="Browse Available Listings"
              style="-fx-fill: #143D29;
                     -fx-font-family: 'Palatino Linotype';
                     -fx-font-size: 36px;
                     -fx-font-weight: bold;"/>
        <Text text="Click on any listing to view details"
              style="-fx-fill: #8B7355;
                     -fx-font-family: 'Cambria';
                     -fx-font-size: 14px;"/>
    </VBox>

    <!-- Search and Filter Bar -->
    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: white;
                 -fx-background-radius: 8;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                 -fx-padding: 12 16;">
        <TextField fx:id="searchField"
                   promptText="Search by street or city..."
                   prefWidth="260"
                   style="-fx-background-color: #F5F0E8;
                          -fx-background-radius: 6;
                          -fx-border-color: #D4C4B0;
                          -fx-border-radius: 6;
                          -fx-padding: 7 12;
                          -fx-font-family: 'Cambria';
                          -fx-font-size: 13px;"/>
        <Label text="Max price (DKK):"
               style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 13px; -fx-font-weight: bold;"/>
        <ComboBox fx:id="maxPriceFilter" promptText="Any price"
                  style="-fx-font-family: 'Cambria'; -fx-font-size: 13px;"/>
        <Label text="Min rooms:"
               style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 13px; -fx-font-weight: bold;"/>
        <ComboBox fx:id="minRoomsFilter" promptText="Any"
                  style="-fx-font-family: 'Cambria'; -fx-font-size: 13px;"/>
        <Button fx:id="clearFilterBtn" text="Clear Filters" onAction="#handleClearFilters"
                style="-fx-background-color: #8B7355;
                       -fx-text-fill: white;
                       -fx-font-family: 'Cambria';
                       -fx-font-size: 12px;
                       -fx-background-radius: 6;
                       -fx-padding: 7 16;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- Scrollable Listings Container -->
    <ScrollPane fx:id="listingsScrollPane" 
                fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F0E8; -fx-background-color: transparent;">
        
        <TilePane fx:id="listingsTilePane"
                  hgap="20" vgap="20"
                  prefColumns="3"
                  style="-fx-background-color: #F5F0E8;">
            
            <!-- Listing cards will be added dynamically here -->
            
        </TilePane>
    </ScrollPane>

    <!-- Status Label -->
    <Label fx:id="statusLabel" 
           text="Loading listings..."
           style="-fx-text-fill: #8B7355;
                  -fx-font-family: 'Cambria';
                  -fx-font-size: 13px;"/>

</VBox>
