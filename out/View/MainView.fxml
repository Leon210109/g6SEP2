<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="View.MainController"
      style="-fx-background-color: #F5F0E8;">

    <!-- ── Header ── -->
    <HBox fx:id="header" alignment="CENTER_LEFT"
          style="-fx-background-color: #F5F0E8;
                 -fx-border-color: #1A5F3F;
                 -fx-border-width: 0 0 3 0;">
        <padding>
            <Insets top="14" right="20" bottom="12" left="20"/>
        </padding>

        <!-- Left: title + section breadcrumb -->
        <HBox fx:id="titleBox" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <Text fx:id="titleText" text="Booking via VIA"
                  onMouseClicked="#handleTitleClick"
                  onMouseEntered="#handleTitleEnter"
                  onMouseExited="#handleTitleExit"
                  style="-fx-fill: #143D29; -fx-cursor: hand;
                         -fx-font-family: 'Palatino Linotype';
                         -fx-font-size: 28px;
                         -fx-font-weight: bold;
                         -fx-font-style: italic;"/>
            <Text fx:id="headerSub" text="  Home"
                  style="-fx-fill: #1A5F3F;
                         -fx-font-family: 'Cambria';
                         -fx-font-size: 15px;"/>
        </HBox>

        <!-- Center: Back to Login -->
        <HBox fx:id="centerBox" alignment="CENTER" HBox.hgrow="ALWAYS">
            <Button fx:id="backToLoginBtn" text="Back to Login" onAction="#handleBackToLogin"
                    style="-fx-background-color: #1A5F3F;
                           -fx-text-fill: #F5F0E8;
                           -fx-font-family: 'Cambria';
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 6 20;
                           -fx-cursor: hand;"/>
        </HBox>

        <!-- Right: exit hint + nav dropdown -->
        <HBox fx:id="rightBox" spacing="12" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <Label text="Press ESC to exit fullscreen"
                   style="-fx-text-fill: #8B7355;
                          -fx-font-family: 'Cambria';
                          -fx-font-size: 11px;"/>
            <MenuButton fx:id="navMenu" text="Navigate ▾" styleClass="nav-menu"
                        style="-fx-background-color: #1A5F3F;
                               -fx-text-fill: #F5F0E8;
                               -fx-font-family: 'Cambria';
                               -fx-font-size: 13px;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- ── Content area ── -->
    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #F5F0E8;">

        <!-- Default home view (welcome text) -->
        <VBox fx:id="homeView" alignment="CENTER" spacing="8">
            <Text fx:id="welcomeText" text=""
                  style="-fx-fill: #143D29;
                         -fx-font-family: 'Palatino Linotype';
                         -fx-font-size: 72px;
                         -fx-font-weight: bold;"/>
            <Text fx:id="sectionLabel" text=""
                  style="-fx-fill: #1A5F3F;
                         -fx-font-family: 'Cambria';
                         -fx-font-size: 18px;"/>
        </VBox>

    </StackPane>

</VBox>
