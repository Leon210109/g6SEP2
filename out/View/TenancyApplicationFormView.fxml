<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="View.TenancyApplicationFormController"
      spacing="15"
      style="-fx-background-color: #F5F0E8;"
      prefWidth="540" prefHeight="600">

    <padding>
        <Insets top="25" right="35" bottom="25" left="35"/>
    </padding>

    <!-- Header -->
    <Text text="Rental Application"
          style="-fx-fill: #143D29;
                 -fx-font-family: 'Palatino Linotype';
                 -fx-font-size: 26px;
                 -fx-font-weight: bold;"/>

    <Label fx:id="listingAddressLabel"
           text="Loading..."
           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 13px;"/>

    <Separator style="-fx-background-color: #D4C4B0;"/>

    <!-- Scrollable form -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F0E8; -fx-background-color: transparent;">
        <VBox spacing="14">
            <padding><Insets right="10"/></padding>

            <!-- Occupation & Income -->
            <Text text="About You"
                  style="-fx-fill: #1A5F3F; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <Label text="Occupation *" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="occupationField" promptText="e.g., Software Engineer"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                <Label text="Monthly Income (DKK) *" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="monthlyIncomeField" promptText="e.g., 35000"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Number of Occupants *" GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="numberOfOccupantsField" promptText="e.g., 2"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            </GridPane>

            <Separator style="-fx-background-color: #D4C4B0;"/>

            <!-- Pets -->
            <Text text="Pets"
                  style="-fx-fill: #1A5F3F; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <CheckBox fx:id="hasPetsCheckBox"
                      text="I have pets"
                      onAction="#handlePetsToggle"
                      style="-fx-font-family: 'Cambria'; -fx-font-size: 13px;"/>

            <VBox fx:id="petsDescBox" spacing="6" visible="false" managed="false">
                <Label text="Describe your pets"
                       style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
                <TextField fx:id="petsDescriptionField"
                           promptText="e.g., 1 small dog, well trained"/>
            </VBox>

            <Separator style="-fx-background-color: #D4C4B0;"/>

            <!-- Additional Info -->
            <Text text="Additional Information"
                  style="-fx-fill: #1A5F3F; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <Label text="Tell the landlord anything else relevant (references, move-in date, etc.)"
                   wrapText="true"
                   style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 12px;"/>

            <TextArea fx:id="additionalInfoArea"
                      promptText="Write here..."
                      prefHeight="100"
                      wrapText="true"/>
        </VBox>
    </ScrollPane>

    <!-- Status message -->
    <Label fx:id="messageLabel"
           wrapText="true"
           style="-fx-text-fill: #B22222; -fx-font-weight: bold;"/>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#handleCancel"
                style="-fx-background-color: #D4C4B0;
                       -fx-text-fill: #143D29;
                       -fx-font-size: 13px;
                       -fx-background-radius: 5;
                       -fx-padding: 10 20;"/>
        <Button text="Submit Application"
                onAction="#handleSubmit"
                style="-fx-background-color: #143D29;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5;
                       -fx-padding: 10 20;"/>
    </HBox>

</VBox>
