@startuml VinylLibraryClassDiagram

skinparam classAttributeIconSize 0
hide circle

' ============ INTERFACES ============

interface Model {
  +addListener(listener: ModelListener): void
  +removeListener(listener: ModelListener): void
  +addVinyl(title: String, artist: String, year: String): void
  +removeVinyl(vinyl: Vinyl): void
  +getVinylList(): List<Vinyl>
  +reserve(vinyl: Vinyl, userName: String): void
  +borrow(vinyl: Vinyl, userName: String): void
  +returnVinyl(vinyl: Vinyl): void
  +getVinylByIndex(index: int): Vinyl
}

interface ModelListener {
  +vinylAdded(vinyl: Vinyl): void
  +vinylRemoved(vinyl: Vinyl): void
  +vinylUpdated(vinyl: Vinyl): void
  +vinylMarkedForRemoval(vinyl: Vinyl): void
}

interface Runnable {
  +run(): void
}

' ============ MODEL PACKAGE CLASSES ============

class ModelManager {
  -vinylList: List<Vinyl>
  -listeners: List<ModelListener>
  +ModelManager()
  -notifyListenersVinylAdded(vinyl: Vinyl): void
  -notifyListenersVinylRemoved(vinyl: Vinyl): void
  -notifyListenersVinylUpdated(vinyl: Vinyl): void
  -notifyListenersVinylMarkedForRemoval(vinyl: Vinyl): void
  +addListener(listener: ModelListener): void
  +removeListener(listener: ModelListener): void
  +addVinyl(title: String, artist: String, year: String): void
  +removeVinyl(vinyl: Vinyl): void
  +getVinylList(): List<Vinyl>
  +reserve(vinyl: Vinyl, userName: String): void
  +borrow(vinyl: Vinyl, userName: String): void
  +returnVinyl(vinyl: Vinyl): void
  +getVinylByIndex(index: int): Vinyl
}

class Vinyl {
  -title: String
  -artist: String
  -year: String
  -state: State
  -markedForRemoval: boolean
  -reserveName: String
  -borrowName: String
  +Vinyl(title: String, artist: String, year: String)
  +getTitle(): String
  +getArtist(): String
  +getYear(): String
  +getState(): State
  +isMarkedForRemoval(): boolean
  +markForRemoval(): void
  +getReserveName(): String
  +getBorrowName(): String
  +setReservedBy(reservedBy: String): void
  +setBorrowedBy(borrowedBy: String): void
  +setState(state: State): void
  +borrowVinyl(): void
  +reserveVinyl(): void
  +returnVinyl(): void
  +removeVinyl(): void
  +toString(): String
}

class VinylList {
  -vinyls: ArrayList<Vinyl>
  -support: PropertyChangeSupport
  +VinylList()
  +get(index: int): Vinyl
  +getVinyls(): ArrayList<Vinyl>
  +addListener(listener: PropertyChangeListener): void
  +removeListener(listener: PropertyChangeListener): void
  +size(): int
  +add(vinyl: Vinyl): void
  +remove(vinyl: Vinyl): void
  +borrow(vinyl: Vinyl, borrowedBy: String): void
  +reserve(vinyl: Vinyl, reservedBy: String): void
  +returnVinyl(vinyl: Vinyl): void
  +markForRemoval(vinyl: Vinyl): void
}

enum State {
  AVAILABLE
  BORROWED
  RESERVED
  BORROWED_RESERVED
  REMOVED
  -label: String
  +State(label: String)
  +getStateName(): String
  +status(): String
  +toString(): String
}

' ============ NETWORKING PACKAGE CLASSES ============

class VinylServer {
  -{static} PORT: int = 8080
  -model: Model
  -logger: ServerLogger
  -serverSocket: ServerSocket
  -clients: List<ClientHandler>
  -running: boolean
  +VinylServer(model: Model)
  +start(): void
  +stop(): void
  +removeClient(client: ClientHandler): void
  +broadcastMessage(message: Message): void
  +vinylAdded(vinyl: Vinyl): void
  +vinylRemoved(vinyl: Vinyl): void
  +vinylUpdated(vinyl: Vinyl): void
  +vinylMarkedForRemoval(vinyl: Vinyl): void
  +{static} main(args: String[]): void
}

class ClientHandler {
  -clientSocket: Socket
  -model: Model
  -server: VinylServer
  -logger: ServerLogger
  -in: BufferedReader
  -out: PrintWriter
  -running: boolean
  +ClientHandler(socket: Socket, model: Model, server: VinylServer)
  +run(): void
  -processRequest(request: String): void
  -handleGetAllVinyls(): Message
  -handleReserve(message: Message): Message
  -handleBorrow(message: Message): Message
  -handleReturn(message: Message): Message
  -findVinyl(vinyl: Vinyl): Vinyl
  +sendMessage(message: Message): void
  +stop(): void
  -cleanup(): void
}

class NetworkClient {
  -{static} SERVER_HOST: String = "localhost"
  -{static} SERVER_PORT: int = 8080
  -socket: Socket
  -in: BufferedReader
  -out: PrintWriter
  -listeners: List<ModelListener>
  -messageListenerThread: Thread
  -running: boolean
  -lastResponse: Message
  -responseLock: Object
  +NetworkClient()
  +connect(): void
  +disconnect(): void
  -listenForServerMessages(): void
  -handleBroadcastMessage(message: Message): void
  -isBroadcastMessage(type: String): boolean
  -sendRequest(message: Message): Message
  +addListener(listener: ModelListener): void
  +removeListener(listener: ModelListener): void
  +addVinyl(title: String, artist: String, year: String): void
  +removeVinyl(vinyl: Vinyl): void
  +getVinylList(): List<Vinyl>
  +reserve(vinyl: Vinyl, userName: String): void
  +borrow(vinyl: Vinyl, userName: String): void
  +returnVinyl(vinyl: Vinyl): void
  +getVinylByIndex(index: int): Vinyl
}

class Message {
  -type: String
  -data: String
  -error: String
  -success: boolean
  +Message(type: String, data: String)
  +Message(type: String, data: String, success: boolean, error: String)
  +getType(): String
  +getData(): String
  +getError(): String
  +isSuccess(): boolean
  +toJson(): String
  +{static} fromJson(json: String): Message
  +{static} getAllVinylsRequest(): Message
  +{static} getAllVinylsResponse(vinyls: List<Vinyl>): Message
  +{static} reserveRequest(vinyl: Vinyl, userName: String): Message
  +{static} borrowRequest(vinyl: Vinyl, userName: String): Message
  +{static} returnRequest(vinyl: Vinyl): Message
  +{static} errorResponse(type: String, error: String): Message
  +{static} vinylUpdateBroadcast(vinyl: Vinyl): Message
  +{static} vinylRemovedBroadcast(vinyl: Vinyl): Message
  +{static} vinylAddedBroadcast(vinyl: Vinyl): Message
}

class ServerLogger {
  -{static} instances: Map<String, ServerLogger>
  -{static} dateFormat: SimpleDateFormat
  -{static} timestampFormat: SimpleDateFormat
  -{static} LOG_DIRECTORY: String = "server_logs"
  -logDate: String
  -fileWriter: PrintWriter
  -ServerLogger(date: String)
  +{static} getInstance(): ServerLogger
  +log(type: String, ipAddress: String, message: String): void
  +logIncoming(clientAddress: InetAddress, port: int, message: String): void
  +logOutgoing(clientAddress: InetAddress, port: int, message: String): void
  +logServerEvent(event: String): void
  +logClientConnected(clientAddress: InetAddress, port: int): void
  +logClientDisconnected(clientAddress: InetAddress, port: int): void
  +logError(ipAddress: String, error: String): void
  +{static} closeAll(): void
}

' ============ VIEWMODEL PACKAGE CLASSES ============

class AppVM {
  -model: Model
  -viewState: ViewState
  -vinyls: ObservableList<Vinyl>
  -errorLabel: StringProperty
  +AppVM(model: Model, viewState: ViewState)
  -refreshVinylList(): void
  +vinylAdded(vinyl: Vinyl): void
  +vinylRemoved(vinyl: Vinyl): void
  +vinylUpdated(vinyl: Vinyl): void
  +vinylMarkedForRemoval(vinyl: Vinyl): void
  +getVinyls(): ObservableList<Vinyl>
  +errorLabelProperty(): StringProperty
  +reserveVinyl(vinyl: Vinyl, userName: String): void
  +borrowVinyl(vinyl: Vinyl, userName: String): void
  +returnVinyl(vinyl: Vinyl): void
  +removeVinyl(vinyl: Vinyl): void
  +setSelectedVinyl(vinyl: Vinyl): void
  +getSelectedVinyl(): Vinyl
}

class FrontVM {
  +FrontVM(model: Model, viewState: ViewState)
}

class ManageVM {
  -model: Model
  -viewState: ViewState
  -vinyls: ObservableList<Vinyl>
  -errorLabel: StringProperty
  +ManageVM(model: Model, viewState: ViewState)
  -refreshVinylList(): void
  +vinylAdded(vinyl: Vinyl): void
  +vinylRemoved(vinyl: Vinyl): void
  +vinylUpdated(vinyl: Vinyl): void
  +vinylMarkedForRemoval(vinyl: Vinyl): void
  +getVinyls(): ObservableList<Vinyl>
  +errorLabelProperty(): StringProperty
  +reserveVinyl(vinyl: Vinyl, userName: String): void
  +borrowVinyl(vinyl: Vinyl, userName: String): void
  +returnVinyl(vinyl: Vinyl): void
  +removeVinyl(vinyl: Vinyl): void
  +setSelectedVinyl(vinyl: Vinyl): void
  +getSelectedVinyl(): Vinyl
}

class ViewState {
  -selectedVinyl: Vinyl
  -support: PropertyChangeSupport
  +ViewState()
  +getSelectedVinyl(): Vinyl
  +setSelectedVinyl(vinyl: Vinyl): void
  +addListener(listener: PropertyChangeListener): void
  +removeListener(listener: PropertyChangeListener): void
}

' ============ VIEW PACKAGE CLASSES ============

class ViewHandler {
  -primaryStage: Stage
  -frontController: FrontController
  -manageController: ManageController
  -frontVM: FrontVM
  -manageVM: ManageVM
  +ViewHandler(primaryStage: Stage, vinylList: VinylList, frontVM: FrontVM, manageVM: ManageVM)
  +start(): void
  -loadFrontView(): void
  -loadManageView(): void
  +openFrontView(): void
  +openManageView(selectedVinyl: Vinyl): void
}

class FrontController {
  -vinylTable: TableView<Vinyl>
  -titleColumn: TableColumn<Vinyl, String>
  -artistColumn: TableColumn<Vinyl, String>
  -yearColumn: TableColumn<Vinyl, String>
  -statusColumn: TableColumn<Vinyl, String>
  -viewHandler: ViewHandler
  -frontVM: FrontVM
  -scene: Scene
  -initialize(): void
  +init(viewHandler: ViewHandler, frontVM: FrontVM, scene: Scene): void
  -onManageClick(): void
  +getScene(): Scene
  +updateVinylTable(): void
}

class ManageController {
  -titleLabel: Label
  -artistLabel: Label
  -yearLabel: Label
  -stateLabel: Label
  -titleField: TextField
  -artistField: TextField
  -yearField: TextField
  -stateField: TextField
  -borrowButton: Button
  -reserveButton: Button
  -returnButton: Button
  -removeButton: Button
  -cancelButton: Button
  -viewHandler: ViewHandler
  -scene: Scene
  -selectedVinyl: Vinyl
  -manageVM: ManageVM
  +init(viewHandler: ViewHandler, scene: Scene, manageVM: ManageVM): void
  +getScene(): Scene
  +setSelectedVinyl(vinyl: Vinyl): void
  -updateUI(): void
  -onReturnToFrontViewClick(): void
  -onBorrowButtonClick(): void
  -onReserveButtonClick(): void
  -onReturnButtonClick(): void
  -onRemoveButtonClick(): void
}

' ============ ROOT PACKAGE CLASSES ============

class StartApplication {
  -model: Model
  -vinylList: VinylList
  -viewState: ViewState
  -frontVM: FrontVM
  -manageVM: ManageVM
  +{static} main(args: String[]): void
  +start(primaryStage: Stage): void
  +stop(): void
  -initializeVinylCollection(): void
}

class StartClient {
  -networkClient: NetworkClient
  -vinylList: VinylList
  -viewState: ViewState
  -frontVM: FrontVM
  -manageVM: ManageVM
  +{static} main(args: String[]): void
  +start(primaryStage: Stage): void
  +stop(): void
}

' ============ RELATIONSHIPS ============

' Model Package Relationships
ModelManager ..|> Model
NetworkClient ..|> Model
ModelManager --> ModelListener : notifies >
Vinyl --> State : has >
VinylList o-- Vinyl : contains
ModelManager o-- Vinyl : manages

' Networking Package Relationships
VinylServer ..|> ModelListener
VinylServer --> Model : uses >
VinylServer o-- ClientHandler : manages
VinylServer --> ServerLogger : uses >
ClientHandler ..|> Runnable
ClientHandler --> Model : uses >
ClientHandler --> VinylServer : references >
ClientHandler --> ServerLogger : uses >
ClientHandler --> Message : uses >
NetworkClient o-- ModelListener : notifies >
NetworkClient --> Message : uses >

' ViewModel Package Relationships
AppVM ..|> ModelListener
ManageVM ..|> ModelListener
FrontVM --|> AppVM
AppVM --> Model : uses >
AppVM --> ViewState : uses >
ManageVM --> Model : uses >
ManageVM --> ViewState : uses >
ViewState --> Vinyl : references >

' View Package Relationships
ViewHandler --> FrontController : manages >
ViewHandler --> ManageController : manages >
ViewHandler --> FrontVM : uses >
ViewHandler --> ManageVM : uses >
FrontController --> ViewHandler : uses >
FrontController --> FrontVM : uses >
FrontController --> Vinyl : displays >
ManageController --> ViewHandler : uses >
ManageController --> ManageVM : uses >
ManageController --> Vinyl : displays >

' Root Package Relationships
StartApplication --> ModelManager : creates >
StartApplication --> ViewHandler : creates >
StartApplication --> FrontVM : creates >
StartApplication --> ManageVM : creates >
StartApplication --> ViewState : creates >
StartApplication --> VinylList : creates >
StartClient --> NetworkClient : creates >
StartClient --> ViewHandler : creates >
StartClient --> FrontVM : creates >
StartClient --> ManageVM : creates >
StartClient --> ViewState : creates >
StartClient --> VinylList : creates >

@enduml
