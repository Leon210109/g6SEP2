<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="View.MyFavoritesController"
      spacing="20"
      style="-fx-background-color: #F5F0E8;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Header -->
    <VBox spacing="8">
        <Text text="My Favourites"
              style="-fx-fill: #143D29;
                     -fx-font-family: 'Palatino Linotype';
                     -fx-font-size: 36px;
                     -fx-font-weight: bold;"/>
        <Text text="Listings you have saved for later"
              style="-fx-fill: #8B7355;
                     -fx-font-family: 'Cambria';
                     -fx-font-size: 14px;"/>
    </VBox>

    <!-- Listings grid -->
    <ScrollPane fx:id="favScrollPane"
                fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F0E8; -fx-background-color: transparent;">

        <TilePane fx:id="favTilePane"
                  hgap="20" vgap="20"
                  prefColumns="3"
                  style="-fx-background-color: #F5F0E8;"/>
    </ScrollPane>

    <Label fx:id="statusLabel"
           text="Loading favourites..."
           style="-fx-text-fill: #8B7355;
                  -fx-font-family: 'Cambria';
                  -fx-font-size: 13px;"/>

</VBox>
