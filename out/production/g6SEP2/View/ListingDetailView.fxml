<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="View.ListingDetailController"
      spacing="0"
      prefWidth="700"
      prefHeight="600"
      style="-fx-background-color: #F5F0E8;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" 
          style="-fx-background-color: #1A5F3F; -fx-padding: 20;">
        <Text fx:id="titleText"
              text="Property Details"
              style="-fx-fill: white;
                     -fx-font-family: 'Palatino Linotype';
                     -fx-font-size: 28px;
                     -fx-font-weight: bold;"/>
    </HBox>

    <!-- Scrollable Content -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F0E8; -fx-background-color: transparent;">
        
        <VBox spacing="25">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <!-- Image Gallery -->
            <VBox spacing="10">
                <Text text="Photos"
                      style="-fx-fill: #143D29;
                             -fx-font-family: 'Palatino Linotype';
                             -fx-font-size: 20px;
                             -fx-font-weight: bold;"/>
                
                <ScrollPane fitToWidth="true" 
                            prefHeight="250"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <FlowPane fx:id="imageGallery" 
                              hgap="10" vgap="10"
                              style="-fx-background-color: transparent;">
                        <!-- Images loaded dynamically -->
                    </FlowPane>
                </ScrollPane>
            </VBox>

            <!-- Property Information -->
            <VBox spacing="15" 
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-padding: 20;
                         -fx-border-color: #D4C4B0;
                         -fx-border-radius: 10;
                         -fx-border-width: 2;">
                
                <Text text="Property Information"
                      style="-fx-fill: #143D29;
                             -fx-font-family: 'Palatino Linotype';
                             -fx-font-size: 20px;
                             -fx-font-weight: bold;"/>

                <!-- Listing type badge -->
                <Label fx:id="listingTypeLabel"
                       text="Short-term"
                       style="-fx-background-color: #1A5F3F;
                              -fx-text-fill: white;
                              -fx-font-family: 'Cambria';
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;
                              -fx-background-radius: 4;
                              -fx-padding: 4 10;"/>

                <GridPane hgap="20" vgap="12">
                    <!-- Address -->
                    <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="addressLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Room Number -->
                    <Label text="Apartment:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="roomNumberLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Rooms -->
                    <Label text="Rooms:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="roomsLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Bathrooms -->
                    <Label text="Bathrooms:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="bathroomsLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Surface Area -->
                    <Label text="Surface Area:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="surfaceAreaLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Max People -->
                    <Label text="Max Occupancy:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="maxPeopleLabel" GridPane.columnIndex="1" GridPane.rowIndex="5"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Balcony -->
                    <Label text="Balcony:" GridPane.columnIndex="0" GridPane.rowIndex="6"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="balconyLabel" GridPane.columnIndex="1" GridPane.rowIndex="6"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Last Renovated -->
                    <Label text="Last Renovated:" GridPane.columnIndex="0" GridPane.rowIndex="7"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="renovatedLabel" GridPane.columnIndex="1" GridPane.rowIndex="7"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Price -->
                    <Label text="Rent:" GridPane.columnIndex="0" GridPane.rowIndex="8"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="priceLabel" GridPane.columnIndex="1" GridPane.rowIndex="8"
                           style="-fx-text-fill: #1A5F3F; -fx-font-family: 'Cambria'; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                </GridPane>
            </VBox>

            <!-- Landlord Information -->
            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-padding: 20;
                         -fx-border-color: #D4C4B0;
                         -fx-border-radius: 10;
                         -fx-border-width: 2;">
                
                <Text text="Landlord Information"
                      style="-fx-fill: #143D29;
                             -fx-font-family: 'Palatino Linotype';
                             -fx-font-size: 20px;
                             -fx-font-weight: bold;"/>

                <GridPane hgap="20" vgap="12">
                    <!-- Name -->
                    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="ownerNameLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Email -->
                    <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="ownerEmailLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>

                    <!-- Phone -->
                    <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-text-fill: #8B7355; -fx-font-family: 'Cambria'; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="ownerPhoneLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"
                           style="-fx-text-fill: #143D29; -fx-font-family: 'Cambria'; -fx-font-size: 14px;"/>
                </GridPane>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Footer Buttons -->
    <HBox spacing="15" alignment="CENTER" 
          style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #D4C4B0; -fx-border-width: 2 0 0 0;">
        
        <Button fx:id="bookButton" 
                text="Book This Property"
                onAction="#handleBook"
                style="-fx-background-color: #1A5F3F;
                       -fx-text-fill: white;
                       -fx-font-family: 'Cambria';
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;
                       -fx-padding: 10 30;
                       -fx-cursor: hand;"/>
        
        <Button text="Close" 
                onAction="#handleClose"
                style="-fx-background-color: #8B7355;
                       -fx-text-fill: white;
                       -fx-font-family: 'Cambria';
                       -fx-font-size: 14px;
                       -fx-background-radius: 6;
                       -fx-padding: 10 30;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>
