<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="View.BookingDialogController"
      spacing="20"
      style="-fx-background-color: #F5F0E8;"
      prefWidth="400" prefHeight="350">
    
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- Header -->
    <Text text="Book This Property"
          style="-fx-fill: #143D29;
                 -fx-font-family: 'Palatino Linotype';
                 -fx-font-size: 24px;
                 -fx-font-weight: bold;"/>

    <Text fx:id="propertyText" 
          text="Property Name"
          style="-fx-fill: #8B7355;
                 -fx-font-family: 'Cambria';
                 -fx-font-size: 14px;"/>

    <!-- Booking Details -->
    <GridPane hgap="15" vgap="15">
        <Label text="Check-in Date:" GridPane.rowIndex="0" GridPane.columnIndex="0"
               style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
        <DatePicker fx:id="startDatePicker" 
                    promptText="Select check-in date"
                    GridPane.rowIndex="0" GridPane.columnIndex="1"
                    prefWidth="200"/>

        <Label text="Check-out Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"
               style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
        <DatePicker fx:id="endDatePicker" 
                    promptText="Select check-out date"
                    GridPane.rowIndex="1" GridPane.columnIndex="1"
                    prefWidth="200"/>

        <Label text="Number of People:" GridPane.rowIndex="2" GridPane.columnIndex="0"
               style="-fx-text-fill: #143D29; -fx-font-weight: bold;"/>
        <TextField fx:id="numberOfPeopleField" 
                   promptText="e.g., 2"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"
                   prefWidth="200"/>
    </GridPane>

    <!-- Check-in/out times info -->
    <VBox spacing="5" style="-fx-background-color: #E8E0D5; -fx-padding: 10; -fx-background-radius: 5;">
        <Text fx:id="checkInTimeText" text="Check-in time: 3:00 PM"
              style="-fx-fill: #1A5F3F; -fx-font-size: 12px;"/>
        <Text fx:id="checkOutTimeText" text="Check-out time: 11:00 AM"
              style="-fx-fill: #1A5F3F; -fx-font-size: 12px;"/>
        <Text fx:id="maxPeopleText" text="Maximum occupancy: 4 people"
              style="-fx-fill: #8B7355; -fx-font-size: 11px;"/>
    </VBox>

    <!-- Error/Success Messages -->
    <Label fx:id="messageLabel" 
           wrapText="true"
           style="-fx-text-fill: #B22222; -fx-font-weight: bold;"/>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancel" 
                onAction="#handleCancel"
                style="-fx-background-color: #D4C4B0;
                       -fx-text-fill: #143D29;
                       -fx-font-size: 13px;
                       -fx-background-radius: 5;
                       -fx-padding: 8 25;"/>
        <Button text="Confirm Booking" 
                onAction="#handleBook"
                style="-fx-background-color: #1A5F3F;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5;
                       -fx-padding: 8 25;"/>
    </HBox>
</VBox>
