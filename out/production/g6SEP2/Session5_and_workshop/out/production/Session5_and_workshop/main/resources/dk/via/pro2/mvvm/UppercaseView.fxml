<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="dk.via.pro2.mvvm.UppercaseViewController"
      spacing="10" style="-fx-padding: 20;">

    <Label text="Input:"/>
    <TextField fx:id="inputField" promptText="Enter text here..."/>

    <Button text="Convert to Uppercase" onAction="#onConvert"/>

    <Label text="Output:"/>
    <TextField fx:id="outputField" editable="false"/>

</VBox>

